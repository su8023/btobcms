{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.10",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "nwidart/laravel-modules": "^13.0",
        "spatie/laravel-translatable": "^6.15"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "files": [
            "app/Support/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\FeishuNotifier\\": "Modules/FeishuNotifier/app/",
            "Modules\\FeishuNotifier\\Database\\Factories\\": "Modules/FeishuNotifier/database/factories/",
            "Modules\\FeishuNotifier\\Database\\Seeders\\": "Modules/FeishuNotifier/database/seeders/",
            "Modules\\AiSeoAuditor\\": "Modules/AiSeoAuditor/app/",
            "Modules\\AiSeoAuditor\\Database\\Factories\\": "Modules/AiSeoAuditor/database/factories/",
            "Modules\\AiSeoAuditor\\Database\\Seeders\\": "Modules/AiSeoAuditor/database/seeders/",
            "Modules\\AiContentWriter\\": "Modules/AiContentWriter/app/",
            "Modules\\AiContentWriter\\Database\\Factories\\": "Modules/AiContentWriter/database/factories/",
            "Modules\\AiContentWriter\\Database\\Seeders\\": "Modules/AiContentWriter/database/seeders/",
            "Modules\\MailNotifier\\": "Modules/MailNotifier/app/",
            "Modules\\MailNotifier\\Database\\Factories\\": "Modules/MailNotifier/database/factories/",
            "Modules\\MailNotifier\\Database\\Seeders\\": "Modules/MailNotifier/database/seeders/",
            "Modules\\WhatsAppChat\\": "Modules/WhatsAppChat/app/",
            "Modules\\WhatsAppChat\\Database\\Factories\\": "Modules/WhatsAppChat/database/factories/",
            "Modules\\WhatsAppChat\\Database\\Seeders\\": "Modules/WhatsAppChat/database/seeders/",
            "Modules\\UpdateCenter\\": "Modules/UpdateCenter/app/",
            "Modules\\UpdateCenter\\Database\\Factories\\": "Modules/UpdateCenter/database/factories/",
            "Modules\\UpdateCenter\\Database\\Seeders\\": "Modules/UpdateCenter/database/seeders/",
            "Modules\\AutoSeo\\": "Modules/AutoSeo/app/",
            "Modules\\LinkWeaver\\": "Modules/LinkWeaver/app/",
            "Modules\\LeadLens\\": "Modules/LeadLens/app/",
            "Modules\\GeoBoost\\": "Modules/GeoBoost/app/",
            "Modules\\TransCoverage\\": "Modules/TransCoverage/app/",
            "Modules\\GscPulse\\": "Modules/GscPulse/app/",
            "Modules\\LeadMagnet\\": "Modules/LeadMagnet/app/",
            "Modules\\TrustBuilder\\": "Modules/TrustBuilder/app/",
            "Modules\\ImageForge\\": "Modules/ImageForge/app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "*": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
